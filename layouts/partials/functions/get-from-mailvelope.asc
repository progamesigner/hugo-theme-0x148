{{- $field := 0 | index . | lower -}}
{{- $value := 1 | index . -}}

{{- $url := slice $field $value | partial "functions/format-mailvelope-url.string" -}}
{{- $data := dict -}}
{{- with try (resources.GetRemote $url) -}}
    {{- with .Err -}}
        {{- errorf "Failed to fetch mailvelope key from %s: %s" $url . -}}
    {{- else with .Value -}}
        {{- $data = . | transform.Unmarshal -}}
    {{- else -}}
        {{- errorf "Failed to fetch mailvelope key from %s" $url -}}
    {{- end -}}
{{- end -}}
{{- $key := $data.publicKeyArmored | htmlUnescape | htmlUnescape | safeHTML | strings.TrimRight "\n\r" -}}

{{- return $key -}}
